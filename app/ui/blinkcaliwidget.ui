  <property name="styleSheet">
   <string notr="true">#frame_result,#frame_blink,#frame_feedback{
    border: 1px solid #696969;
    border-radius: 5px;
}

#frame_background{
	background-color: #FAFAFA; /* 柔和的浅灰色 */
}

QPushButton{
    color: #ffffff; /* 按钮文本为白色 */
    border: none;
    background-color: #828282; /* 按钮默认状态为中性灰色 */
    border-radius: 5px;
}

QPushButton:hover{
    color: #ffffff;
    border: none;
    background-color: #606060; /* 悬停时按钮变为深灰色 */
    border-radius: 5px;
}

QPushButton:pressed{
    color: #ffffff;
    border: none;
    background-color: #828282; /* 按下按钮时为中灰色 */
    border-radius: 5px;
}</string>
