  <property name="styleSheet">
   <string notr="true">/**
    该页面为灰色皮肤

    控件名前加个#代表指定某个控件；
    border-image表示填充整个背景；
    background-image表示设置背景，但不填充;
    border表示边框大小;
    border-radius表示边框圆角大小;
    color表示字体颜色；background-position表示图片位置;
    background-repeat表示图片是否重复显示
*/

#LoginWidget {
	background-color:#FFFFFF; /*背景颜色*/
    border-radius: 10px;             /*四角圆角的直径*/
    border-style:solid;             /*边框样式（实线）*/
    border-width:2px;             /*边框宽度*/
    border-color:rgb(213, 213, 213);     /*边框颜色*/
}

#btn_min, #btn_close {
	background-color:rgb(255,255,255,1);
	border-radius:0px;
}


QFrame {
	border-width:0px;
}

#frame_login{
    background-color: #ffffff; /* 保持登录框为白色 */
}

#frame_img{
    /*background-image:url(:/img/login_img2.png);*/
}

#frame_account, #frame_pwd, #frame_pwd_2{
    border: 1px solid; /* 边框为深灰色 */
	border-color:rgb(95, 95, 95);
    border-radius: 5px; /* 圆角边框 */
}


#frame_code{
    color: #ffffff; /* 保持文本为白色，确保在深灰背景上清晰可见 */
    border: none;
    background-color: #E3E3E3; /* 中灰色背景 */
    border-radius: 5px;
}

QLineEdit{
    border: none; /* 输入框无边框 */
}

#pushButton{
    color: rgb(0, 0, 0); /* 按钮文本为白色 */
    border: none;
    background-color: #E3E3E3; /* 按钮默认状态为中性灰色 */
    border-radius: 5px;
}

#pushButton:hover{
    color: #ffffff;
    border: none;
    background-color: #E3E3E3; /* 悬停时按钮变为深灰色 */
    border-radius: 5px;
}

#pushButton:pressed{
    color: #ffffff;
    border: none;
    background-color: #828282; /* 按下按钮时为中灰色 */
    border-radius: 5px;
}

#label_login{
    color: #505050; /* 登录标签为深灰色 */
}

#label_account{
    border-image: url(:/img/user_name.png); /* 用户名图标 */
}

#label_pwd{
    border-image: url(:/img/pwd.png); /* 密码图标 */
}

#label_result{
	background-color:#E3E3E3;
border-radius:10px;
}
</string>
