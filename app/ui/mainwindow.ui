   <string notr="true">QMainWindow{         /*类名*/
    background-color:#F6F6F6; /*背景颜色*/
    border-radius: 10px;             /*四角圆角的直径*/
    border-style:solid;             /*边框样式（实线）*/
    border-width:2px;             /*边框宽度*/
    border-color:rgb(213, 213, 213);     /*边框颜色*/
}

QFrame {
	border-radius:0px;
}

#frame {
	background-color:#FAFAFA;
}

#btn_min, #btn_close {
	background-color:rgb(255,255,255,1);
	border-radius:0px;
}

#statusBar {
	background-color:rgba(213, 213, 213, 0); 
}

#sideBar{
	background-color:#F6F6F6;
    border-radius: 10px;             /*四角圆角的直径*/
}

#stackedWidget {
	background-color:#FAFAFA;
    border-radius: 10px;             /*四角圆角的直径*/
}


/* 默认 */
QToolButton{   
	background-color:#F6F6F6;
	color:#626262;
    border-radius: 5px;
}

/* 鼠标悬停 */
QToolButton:hover{
	background-color: #E9E9E9;
}

/* 点击和按下 */
QToolButton:pressed,QToolButton:checked{
	background-color: #E9E9E9;	
}

#btnSet:pressed,#btnSet:checked{
	background-color:#F6F6F6;
	color:#626262;
    border-radius: 5px;
}

QPushButton:default {
    /*border-color: navy; /* make the default button prominent */*/
}

#username {
	font: 10pt &quot;Microsoft YaHei UI&quot;;
    color: #666666; 
}</string>
