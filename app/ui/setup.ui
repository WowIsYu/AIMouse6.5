   <string notr="true">QMainWindow{         /*类名*/
    background-color:#F6F6F6; /*背景颜色*/
    border-radius: 10px;             /*四角圆角的直径*/
    border-style:solid;             /*边框样式（实线）*/
    border-width:2px;             /*边框宽度*/
    border-color:rgb(213, 213, 213);     /*边框颜色*/
}

QFrame {
	border-radius:0px;
}

#frame {
	background-color:#FAFAFA;
}

#btn_min, #btn_close {
	background-color:rgb(255,255,255,1);
	border-radius:0px;
}

#statusBar {
	background-color:rgba(213, 213, 213, 0); 
}

#sideBar{
	background-color:#F6F6F6;
    border-radius: 10px;             /*四角圆角的直径*/
}

#stackedWidget {
	background-color:#FAFAFA;
    border-radius: 10px;             /*四角圆角的直径*/
}


/* 默认 */
QPushButton{   
	background-color:#F6F6F6;
	color:#626262;
    border-radius: 5px;
}

/* 鼠标悬停 */
QPushButton:hover{
	background-color: #E9E9E9;
}

/* 点击和按下 */
QPushButton:pressed,QToolButton:checked{
	background-color: #E9E9E9;	
}

